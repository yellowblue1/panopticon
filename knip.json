{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/shared/types.ts", "bin/cli.ts", "**/*.test.ts", "test-setup.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts"]
    },
    "web": {
      "vite": true,
      "entry": ["src/client/main.tsx", "**/*.test.ts"],
      "project": ["**/*.ts", "**/*.tsx"],
      "ignoreDependencies": ["tailwindcss"],
      "ignore": ["src/client/routeTree.gen.ts"]
    }
  }
}
