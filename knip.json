{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/shared/types.ts", "**/*.test.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts"],
      "ignoreDependencies": ["lint-staged"]
    },
    "web": {
      "vite": true,
      "entry": ["**/*.test.ts"],
      "project": ["**/*.ts", "**/*.tsx"],
      "ignoreDependencies": ["tailwindcss"],
      "ignore": ["src/client/routeTree.gen.ts"]
    }
  }
}
