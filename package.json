{
  "name": "@yellowblue1/panopticon",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "panopticon": "bin/cli.ts"
  },
  "files": [
    "bin/",
    "src/",
    "web/server.ts",
    "web/server-app.ts",
    "web/dist/",
    "web/public/"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "prepare": "husky",
    "prepublishOnly": "cd web && bun run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test --test-name-pattern '^(?!.*Integration).*$'",
    "test:integration": "INTEGRATION=true bun test",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "type-coverage": "type-coverage --at-least 99"
  },
  "dependencies": {
    "@google/genai": "^1.52.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.3.14",
    "dependency-cruiser": "^17.4.0",
    "husky": "^9.1.7",
    "knip": "^6.14.2",
    "lint-staged": "^16.4.0",
    "msw": "^2.14.6",
    "type-coverage": "^2.29.7",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": [
      "biome check --write"
    ]
  },
  "overrides": {
    "protobufjs": "^7.5.6",
    "@protobufjs/utf8": "^1.1.1",
    "@hono/node-server": "^1.19.10",
    "express-rate-limit": "^8.2.2",
    "fast-uri": "^3.1.2",
    "path-to-regexp": "^6.3.0 || ^8.4.0",
    "picomatch": "^2.3.2 || ^4.0.4",
    "ip-address": "^10.2.0",
    "postcss": "^8.5.10",
    "yaml": "^2.8.3",
    "brace-expansion": "^2.0.3 || ^5.0.2"
  }
}
