{
  "name": "panopticon",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test --test-name-pattern '^(?!.*Integration).*$'",
    "test:integration": "INTEGRATION=true bun test",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "^1.3.9",
    "dependency-cruiser": "^17.3.8",
    "msw": "^2.12.10",
    "typescript": "^5.9.3"
  }
}
