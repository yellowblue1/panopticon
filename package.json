{
  "name": "@yellowblue1/panopticon",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "panopticon": "bin/cli.ts"
  },
  "files": [
    "bin/",
    "src/",
    "web/server.ts",
    "web/server-app.ts",
    "web/dist/",
    "web/public/"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "prepublishOnly": "cd web && bun run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test --test-name-pattern '^(?!.*Integration).*$'",
    "test:integration": "INTEGRATION=true bun test",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "type-coverage": "type-coverage --at-least 99"
  },
  "dependencies": {
    "@google/genai": "^1.41.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/bun": "^1.3.9",
    "dependency-cruiser": "^17.3.8",
    "knip": "^5.83.1",
    "msw": "^2.12.10",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.3"
  }
}
