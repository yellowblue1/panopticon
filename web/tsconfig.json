{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["@types/bun"],
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/client/*"],
      "@shared/*": ["../src/shared/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "server.ts", "server-app.ts", "vite.config.ts"],
  "exclude": ["node_modules"]
}
